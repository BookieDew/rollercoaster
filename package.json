{
  "name": "combo-boost-rollercoaster-api",
  "version": "1.0.0",
  "description": "REST API service for time-based rollercoaster loyalty reward with dynamic boost percentages",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "files": [
    "dist/",
    "public/demo/",
    "scripts/migrate-prod.js"
  ],
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-migrations.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "bash scripts/verify.sh",
    "start": "node dist/index.js",
    "test": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:all": "jest",
    "test:coverage": "jest --coverage",
    "migrate": "knex migrate:latest",
    "migrate:prod": "node scripts/migrate-prod.js",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "ride-lab": "ts-node --transpile-only tools/ride-lab/run.ts",
    "ride-lab:compare": "ts-node --transpile-only tools/ride-lab/compare.ts"
  },
  "keywords": [
    "loyalty",
    "rewards",
    "boost",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
