# Combo Boost Rollercoaster API - environment template.
# Local development: cp .env.example .env
# The server validates every value at startup and exits with a list of problems.
# .env is not read when NODE_ENV=test; tests configure themselves.

# --- Application -------------------------------------------------------------
# development | production | test (default: development)
NODE_ENV=development

# HTTP port, integer 1-65535 (default: 3000)
PORT=3000

# Serve the local demo UI at /demo: true | false.
# Default: true in development/test, false in production. An explicit value wins.
# The demo is a local tool; leave it off in production.
# DEMO_UI_ENABLED=true

# --- Database ----------------------------------------------------------------
# The URL scheme selects the driver:
#   sqlite://./dev.db                          SQLite file (development default)
#   postgres://user:password@host:5432/dbname  PostgreSQL (not yet verified; the
#                                              pg driver is not installed)
# Required in production. Ignored when NODE_ENV=test (tests use in-memory SQLite).
DATABASE_URL=sqlite://./dev.db

# PostgreSQL only: connection pool size (defaults 2 and 10) and TLS.
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Authentication secrets --------------------------------------------------
# API_KEY_SECRET        service key: X-API-Key for player/bet endpoints.
# ADMIN_API_KEY_SECRET  admin key: X-API-Key for profile and simulation endpoints.
# HMAC_SECRET           key for X-Signature request signing.
#
# Development/test: optional. API_KEY_SECRET defaults to dev-secret-key (the key
# pre-filled in the demo page); the other two default to API_KEY_SECRET.
# Secrets may never be set to an empty value.
#
# Production (NODE_ENV=production): all three are required, each at least 32
# characters, all different from each other, and never dev-secret-key or one of
# the placeholders below. Generate each one separately, for example:
#   openssl rand -hex 32
# API_KEY_SECRET=change-me-api-key-secret-at-least-32-chars
# ADMIN_API_KEY_SECRET=change-me-admin-api-key-secret-at-least-32-chars
# HMAC_SECRET=change-me-hmac-secret-at-least-32-characters

# Allowed HMAC timestamp skew in milliseconds, positive integer (default: 300000)
HMAC_MAX_SKEW_MS=300000

# Signatures remembered for replay protection, positive integer (default: 10000)
HMAC_REPLAY_CACHE_SIZE=10000

# --- Ride timing (seconds) ---------------------------------------------------
# 0 < RIDE_MIN_DURATION_SECONDS <= RIDE_MAX_DURATION_SECONDS
# 0 <= RIDE_MIN_CRASH_SECONDS <= RIDE_MAX_DURATION_SECONDS
RIDE_MIN_DURATION_SECONDS=2
RIDE_MAX_DURATION_SECONDS=15
RIDE_MIN_CRASH_SECONDS=2
